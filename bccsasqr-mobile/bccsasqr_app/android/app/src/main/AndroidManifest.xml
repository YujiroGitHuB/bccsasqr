<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required so release builds can reach the records API. The Flutter
         template only declares this for debug/profile builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The attendance scanner. Asked for the first time the camera opens,
         not at install — a student who only uses the generator is never
         asked. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Not required: the same app is the students' QR generator, and a
         phone with no usable camera must still be able to install it. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- The camera plugin (camera_android_camerax) declares both of these for
         video recording. The scanner never records — flutter_zxing opens the
         camera with enableAudio: false — so the microphone is removed rather
         than listed among the app's permissions, and "any camera" is made
         optional for the same reason as above. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <!-- The scanner's lock: the phone's fingerprint, face or screen lock
         opens a saved instructor sign-in (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <application
        android:label="BCC SASQR"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides the phone's text-to-speech engine from apps
             that do not ask for it here; without it the app is silent. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
