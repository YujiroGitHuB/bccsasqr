<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP for development hosts only.

    Android 9 (API 28) and later refuse plain http:// by default, so a debug
    build pointed at XAMPP on a laptop fails before a packet leaves the phone.
    The failure is silent enough to look like a broken API.

    This file lives in src/debug/, so it applies to `flutter run` and debug
    APKs and NEVER to a release build — a shipped app still refuses cleartext,
    which is the whole point of the default.

    Named hosts only. A blanket cleartextTrafficPermitted="true" on
    <base-config> would weaken every connection the app makes, including to
    the deployed site.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- `adb reverse tcp:8000 tcp:8000` — the phone's own localhost is
             forwarded to the laptop over the USB cable. No wifi, no firewall
             rule, no IP that changes when the router hands out a new lease. -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!-- The laptop on the LAN, for a phone on the same wifi. Change this
             if the router gives the laptop a different address. -->
        <domain includeSubdomains="true">192.168.1.10</domain>
    </domain-config>
</network-security-config>
