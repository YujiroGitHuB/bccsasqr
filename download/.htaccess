# ============================================================
#  download/ — serve the Android app as an app, not as a zip.
#
#  Without the type, Apache sends an .apk as application/zip or
#  octet-stream, and some Android browsers save it as .zip — which
#  the phone then refuses to install.
# ============================================================

Options -Indexes

<IfModule mod_mime.c>
    AddType application/vnd.android.package-archive .apk
</IfModule>

<FilesMatch "\.apk$">
    <IfModule mod_headers.c>
        # No quotes around the name: the live server (LiteSpeed) sent the
        # escaped \" through literally, and phones saved the file under a
        # mangled name. BCC-SASQR.apk is a valid bare token, so none needed.
        Header set Content-Disposition "attachment; filename=BCC-SASQR.apk"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
